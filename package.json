{
  "name": "@maxqwars/metaform",
  "version": "1.0.9",
  "description": "Metaform is an open library for working with the Anilibria API without external dependencies.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "readme": "https://github.com/maxqwars/metaform#readme",
  "keywords": [
    "anilibria",
    "rest-api",
    "typescript",
    "aniliberty-api",
    "aniliberty"
  ],
  "bugs": "https://github.com/maxqwars/metaform/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxqwars/metaform.git"
  },
  "author": {
    "name": "Maxim \"maxqwars\"Maximenko",
    "email": "maxqwars@gmail.com"
  },
  "files": [
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.mts",
    "dist/index.d.cts",
    "dist/scheme/v1.mjs",
    "dist/scheme/v1.cjs",
    "dist/scheme/v1.d.mts",
    "dist/scheme/v1.d.cts",
    "dist/transport.mjs",
    "dist/transport.cjs",
    "dist/transport.d.mts",
    "dist/transport.d.cts",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    },
    "./scheme/v1": {
      "import": "./dist/scheme/v1.mjs",
      "require": "./dist/scheme/v1.cjs",
      "types": "./dist/scheme/v1.d.mts"
    },
    "./transport": {
      "import": "./dist/transport.mjs",
      "require": "./dist/transport.cjs",
      "types": "./dist/transport.d.mts"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown -d dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "pnpm build && husky install",
    "prepublishOnly": "pnpm test && pnpm check",
    "preversion": "pnpm check",
    "version": "pnpm format && git add .",
    "postversion": "git push && git push --tags",
    "husky:install": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.15.11",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.1",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown ./src/"
  }
}
